# Copy to .env (gitignored). The application does NOT auto-load this file.
# Local Gemini:
#   uv run --locked --env-file .env python -m app.server --backend llm
# Deployments should inject the same variable names into the process environment.
PARSER_BACKEND=llm
GEMINI_API_KEY=
GEMINI_TIMEOUT_SECONDS=30
# DeepSeek alternative:
# DEEPSEEK_API_KEY=
# PARSER_BACKEND=deepseek
# Provider: Google Gemini Developer API / official google-genai SDK.
# Model is fixed in code; no LLM_API_KEY, OPENAI_API_KEY, or LLM_BASE_URL is read.
