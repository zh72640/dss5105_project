# Documentation only: export these variables in the shell; .env is NOT auto-loaded.
PARSER_BACKEND=offline
# Online: export PARSER_BACKEND=llm and inject GEMINI_API_KEY securely.
# GEMINI_API_KEY must contain your Google AI Studio / Gemini API key.
GEMINI_API_KEY=
GEMINI_TIMEOUT_SECONDS=30
# Provider: Google Gemini Developer API, official Google SDK (google-genai).
# Model is fixed to gemini-2.5-flash; endpoint is Google's official default.
# No LLM_API_KEY, OPENAI_API_KEY, LLM_MODEL or LLM_BASE_URL is read.
