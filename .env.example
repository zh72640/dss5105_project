# Copy to .env. Fill only the providers you use; leave the others blank.
# Start: uv run --locked --env-file .env python -m app.server
# Configuration is read once at startup; restart after editing .env.
AGENT_MODE=llm

# Default model alias; blank selects the first configured model.
LLM_DEFAULT_MODEL=

# One model: fill API_KEY and MODEL; leave MODELS blank.
# Multiple models: fill API_KEY and MODELS; leave MODEL blank.
# MODELS format: {"your-alias":"actual-api-model-id"}. Aliases must be unique.
# Example: OPENAI_MODELS='{"model-a":"api-id-a","model-b":"api-id-b"}'
# Set LLM_DEFAULT_MODEL=model-a to make it the default.
# Configure multiple providers below to use models from different providers.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MODELS=

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_MODELS=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_MODELS=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_MODELS=

# Single-model aliases: openai, claude, gemini, deepseek.
# Select Offline / LLM and a configured model in the UI for each request.

# Optional settings (replace PREFIX with OPENAI, ANTHROPIC, GEMINI or DEEPSEEK):
# PREFIX_TIMEOUT_SECONDS=30
# PREFIX_OPTIONS={"temperature":0}
# PREFIX_STRUCTURED_OUTPUT=prompt
# DISPATCH_DB=runtime/dispatch.sqlite3
# DISPATCH_AS_OF=2026-04-01
# DISPATCH_NO_AUTH=0
